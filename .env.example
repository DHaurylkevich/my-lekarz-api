# Server
NODE_ENV=development
PORT=3000
# Set to "true" to auto-sync models with the database on boot
DB_SYNC=false

# PostgreSQL (Neon) — used by src/config/db.js, store.js and sequelize-cli
POSTGRES_PRISMA_URL=
POSTGRES_URL_TEST=
POSTGRES_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Auth
JWT_SECRET=
SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Mail (nodemailer)
EMAIL=
EMAIL_PASS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
